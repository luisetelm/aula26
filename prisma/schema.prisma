generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  firstName   String       @default("")
  lastName    String       @default("")
  isAdmin     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
  sessions    Session[]
  files       StoredFile[]
  submissions Submission[]
  oauthCodes  OAuthCode[]
  oauthTokens OAuthToken[]
}

model Subject {
  id           String       @id @default(cuid())
  name         String
  academicYear String
  group        String       @default("")
  createdAt    DateTime     @default(now())
  enrollments  Enrollment[]
  lessons      Lesson[]
  files        StoredFile[]
}

enum Role {
  TEACHER
  STUDENT
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([subjectId])
}

// Enlace mágico de un solo uso. Solo guardamos el hash del token.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  codeHash  String? // código de 6 cifras, para entrar desde otro navegador
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Una sesión del timeline. Los alumnos solo la ven cuando publishAt ya ha pasado;
// publishAt nulo significa borrador.
model Lesson {
  id          String       @id @default(cuid())
  subjectId   String
  date        DateTime
  title       String
  plan        String       @default("")
  publishAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  materials   Material[]
  assessments Assessment[]

  @@index([subjectId, date])
}

enum MaterialKind {
  TEXT
  LINK
  FILE
}

// publishAt nulo: se publica junto con la sesión.
model Material {
  id        String       @id @default(cuid())
  lessonId  String
  title     String
  kind      MaterialKind
  body      String       @default("")
  url       String?
  fileId    String?      @unique
  publishAt DateTime?
  position  Int          @default(0)
  isSlides  Boolean      @default(false) // las diapositivas de la sesión
  createdAt DateTime     @default(now())
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  file      StoredFile?  @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([lessonId])
}

model Assessment {
  id                 String       @id @default(cuid())
  lessonId           String
  title              String
  instructions       String       @default("")
  dueAt              DateTime?
  weight             Float        @default(0)
  rubric             String       @default("")
  acceptsSubmissions Boolean      @default(false)
  fileId             String?      @unique
  publishAt          DateTime?
  gradesPublished    Boolean      @default(false) // el alumnado ve su nota y comentario
  createdAt          DateTime     @default(now())
  lesson             Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  file               StoredFile?  @relation(fields: [fileId], references: [id], onDelete: SetNull)
  submissions        Submission[]

  @@index([lessonId])
}

// Archivo en el almacenamiento (Supabase Storage o disco local en desarrollo).
model StoredFile {
  id              String      @id @default(cuid())
  subjectId       String
  storageKey      String      @unique
  name            String
  size            Int
  mimeType        String
  uploadedById    String
  uploadTokenHash String?
  uploadedAt      DateTime?
  createdAt       DateTime    @default(now())
  subject         Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploadedBy      User        @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  material        Material?
  assessment      Assessment?
  submissionId    String?
  submission      Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([submissionId])
}

// Entrega de un alumno en una prueba. submittedAt nulo: solo tiene nota (no entregó).
model Submission {
  id            String       @id @default(cuid())
  assessmentId  String
  studentId     String
  note          String       @default("")
  submittedAt   DateTime?
  grade         Float?
  feedback      String       @default("")
  gradedAt      DateTime?
  // Propuesta de Claude (vía conector). Solo la ve el profesorado hasta que la acepta.
  draftGrade    Float?
  draftFeedback String       @default("")
  draftedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assessment    Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student       User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files         StoredFile[]

  @@unique([assessmentId, studentId])
}

// ---------- Conector de Claude (OAuth 2.1 + MCP) ----------

// Aplicación que se ha registrado sola (registro dinámico), por ejemplo Claude.
model OAuthClient {
  id           String       @id @default(cuid())
  name         String       @default("")
  redirectUris String[]
  createdAt    DateTime     @default(now())
  codes        OAuthCode[]
  tokens       OAuthToken[]
}

// Código de autorización de un solo uso (PKCE). Solo guardamos su hash.
model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OAuthTokenKind {
  ACCESS
  REFRESH
}

model OAuthToken {
  id        String         @id @default(cuid())
  tokenHash String         @unique
  kind      OAuthTokenKind
  clientId  String
  userId    String
  expiresAt DateTime
  createdAt DateTime       @default(now())
  client    OAuthClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
