# Base de datos (Supabase > Project Settings > Database > Connection string)
# DATABASE_URL: conexión "Transaction pooler" (puerto 6543) añadiendo ?pgbouncer=true
# DIRECT_URL: conexión directa o "Session pooler" (puerto 5432), usada para las migraciones
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aula26"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aula26"

# Dirección pública de la web, sin barra final (se usa en los enlaces de los correos)
APP_URL="http://localhost:3000"

# Correos que se convierten en administradores la primera vez que entran (separados por comas)
ADMIN_EMAILS="tu.correo@escuela.es"

# Envío de correo con Gmail de Workspace y una contraseña de aplicación.
# Si se dejan vacíos, los enlaces de acceso se imprimen en la consola (útil en desarrollo).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
