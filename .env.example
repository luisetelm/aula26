# Base de datos (Supabase > Project Settings > Database > Connection string)
# DATABASE_URL: conexión "Transaction pooler" (puerto 6543) añadiendo ?pgbouncer=true&schema=aula26
# DIRECT_URL: conexión "Session pooler" (puerto 5432) añadiendo ?schema=aula26; se usa para las migraciones
# El esquema aula26 no lo expone la API REST de Supabase, así que los datos solo son accesibles desde la app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aula26"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aula26"

# Dirección pública de la web, sin barra final (se usa en los enlaces de los correos)
APP_URL="http://localhost:3000"

# Zona horaria del centro (las fechas se introducen y se muestran en ella)
APP_TIMEZONE="Europe/Madrid"

# Archivos (material y entregas) en Supabase Storage. Sin estas variables se guardan en .uploads/ (solo desarrollo).
# SUPABASE_SERVICE_ROLE_KEY es secreta: Project Settings > API Keys > Secret key.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="aula26"

# Correos que se convierten en administradores la primera vez que entran (separados por comas)
ADMIN_EMAILS="tu.correo@escuela.es"

# Envío de correo con Gmail de Workspace y una contraseña de aplicación.
# Si se dejan vacíos, los enlaces de acceso se imprimen en la consola (útil en desarrollo).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
